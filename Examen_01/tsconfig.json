{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "lib": [
      "es2017",
      "dom"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "ns_app/*"
      ],
      "@/*": [
        "ns_app/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "platforms",
    "app"
  ]
}
